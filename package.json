{
  "name": "screen-translator",
  "version": "0.1.0",
  "description": "Прозрачное окно поверх всех окон, которое переводит текст под собой",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.screentranslator",
    "productName": "Screen Translator",
    "asar": false,
    "files": ["main.js", "preload.js", "index.html"],
    "win": { "target": ["portable"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.utilities" }
  }
}
