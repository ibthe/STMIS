{
  "name": "screen-translator",
  "version": "0.9.1",
  "description": "Прозрачное окно поверх всех окон, которое переводит текст под собой",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "franc-min": "^6.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.screentranslator",
    "productName": "Screen Translator",
    "artifactName": "ScreenTranslator-${os}-${arch}.${ext}",
    "asar": false,
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "tray.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "extraResources": [
        {
          "from": "native/ocr.ps1",
          "to": "ocr.ps1"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "native/capture",
          "to": "capture"
        }
      ]
    }
  }
}